# frozen_string_literal: true

# Release lanes. docs/RELEASE.md describes the inputs and the workflow that
# runs them (.github/workflows/release.yml).
#
#   bundle exec fastlane ios certificates      once: create the App Store
#                                              certificate and profiles in the
#                                              match repo
#   bundle exec fastlane ios preflight         profile check, newest TestFlight
#                                              builds as JSON
#   bundle exec fastlane ios profiles          the App IDs' profiles and states
#   bundle exec fastlane ios renew_profile     new App Store profiles after a
#                                              capability change
#   bundle exec fastlane ios beta              build the IPA; upload it to
#                                              TestFlight, or only validate it
#   bundle exec fastlane ios wait_processing   set What to Test, wait for VALID
#   bundle exec fastlane android build         build the signed AAB
#   bundle exec fastlane android play_access   can the service account reach
#                                              the Play app?
#   bundle exec fastlane android internal      upload the AAB to the internal
#                                              track, or only validate it
#   bundle exec fastlane android promote_draft an uploaded versionCode as the
#                                              alpha track's draft release
#   bundle exec fastlane android listing       upload the staged Play listing text
#                                              with or after the production
#                                              release, or only validate it
#   bundle exec fastlane android listing_check compare Play's listing and store
#                                              page with the repo text
#   bundle exec fastlane android listing_preflight production's releases and
#                                              which listing upload would pass

opt_out_usage

require "json"
require "plist"
require "shellwords"
require_relative "play_listing"

APP_ID = "com.snacklist.app"
# The Home Screen widget extension (docs/HOME_WIDGETS.md); the Matchfile lists both.
WIDGET_ID = "#{APP_ID}.HomeWidget"
# Each signed bundle ID and its Xcode target.
SIGNED_TARGETS = { APP_ID => "Runner", WIDGET_ID => "HomeWidget" }.freeze
# fastlane runs lane code inside fastlane/ and actions in app/, so paths are
# absolute.
APP_DIR = File.expand_path("..", __dir__)
AAB = File.join(APP_DIR, "build/app/outputs/bundle/release/app-release.aab")
PLAY_METADATA = File.join(__dir__, "metadata/android")

def build_number
  ENV.fetch("BUILD_NUMBER") { UI.user_error!("BUILD_NUMBER is not set") }
end

# RELEASE_UPLOAD=false builds, signs and validates without publishing.
def upload?
  ENV.fetch("RELEASE_UPLOAD", "false") == "true"
end

def flutter(*args)
  sh("cd #{APP_DIR.shellescape} && flutter #{args.shelljoin}")
end

# Analytics (job 19, docs/ANALYTICS.md): the PostHog project key and host and the internal
# households, from the release environment. Unset, the build has analytics off.
ANALYTICS_DEFINES = %w[POSTHOG_PROJECT_API_KEY POSTHOG_HOST ANALYTICS_INTERNAL_HOUSEHOLDS].freeze

# Snacklist Premium (job 67, docs/PAYWALL_RELEASE.md): the purchase screen and RevenueCat's public
# SDK keys, from the release environment. Unset, the build sells nothing. The integration lock
# follows the server switch integration_lock alone (job 328).
PREMIUM_DEFINES = %w[REVENUECAT_PURCHASES REVENUECAT_APPLE_API_KEY REVENUECAT_GOOGLE_API_KEY].freeze

# Push (job 376, docs/PUSH.md): Firebase's client config from the release environment's variables,
# the iOS pair on the iOS build and the Android pair on the Android one. Unset, the build has no push.
PUSH_DEFINES = %w[FIREBASE_PROJECT_ID FIREBASE_MESSAGING_SENDER_ID FIREBASE_IOS_APP_ID FIREBASE_IOS_API_KEY
                  FIREBASE_ANDROID_APP_ID FIREBASE_ANDROID_API_KEY].freeze

# releases/flags.json at the repo root: a hold released there switches its define on.
FLAGS_JSON = File.expand_path("../../releases/flags.json", __dir__)

# Each build define and the hold it follows: NATIVE_SIRI_LIVE (the iPhone's Siri hint,
# app/lib/core/environment.dart) once native Siri is released.
HOLD_DEFINES = { "NATIVE_SIRI_LIVE" => "native-siri" }.freeze

def hold_defines
  holds = JSON.parse(File.read(FLAGS_JSON)).fetch("holds")
  HOLD_DEFINES.select { |_, hold| holds.dig(hold, "released") == true }
              .map { |name, _| "--dart-define=#{name}=true" }
end

def analytics_defines
  (ANALYTICS_DEFINES + PREMIUM_DEFINES + PUSH_DEFINES).reject { |name| ENV.fetch(name, "").empty? }
                                       .map { |name| "--dart-define=#{name}=#{ENV.fetch(name)}" } +
    hold_defines
end

platform :ios do
  def asc_api_key
    key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      in_house: false
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: key)
    key
  end

  def asc_app
    Spaceship::ConnectAPI::App.find(APP_ID) || UI.user_error!("no App Store Connect app for #{APP_ID}")
  end

  desc "Create or renew the App Store certificate and profile in the match repo"
  lane :certificates do
    match(readonly: false, api_key: asc_api_key)
  end

  # The Release plan job runs this first. A build number must exceed every
  # earlier one, and an unchanged main still ships when no build is installable
  # (TestFlight expired them). Enabling a capability on an App ID invalidates
  # its App Store profile; that fails here, before an hour of macOS build.
  desc "Check the App Store profiles; write TestFlight's highest build and whether one is installable to TESTFLIGHT_JSON"
  lane :preflight do
    asc_api_key
    # A regenerated profile can leave an INVALID one of the same name behind.
    problems = SIGNED_TARGETS.keys.filter_map do |id|
      profile_name = "match AppStore #{id}"
      states = Spaceship::ConnectAPI::Profile.all(filter: { name: profile_name }).map(&:profile_state)
      "'#{profile_name}' is #{states.empty? ? 'missing' : states.join(', ')}" unless states.include?("ACTIVE")
    end
    unless problems.empty?
      UI.user_error!("Profile #{problems.join('; ')}: run `bundle exec fastlane ios renew_profile` (docs/RELEASE.md, Capabilities)")
    end
    builds = Spaceship::ConnectAPI::Build.all(app_id: asc_app.id, sort: "-uploadedDate", limit: 50)
    state = {
      max_build: builds.map { |b| b.version.to_i }.max || 0,
      installable: builds.any? { |b| b.processing_state == "VALID" && !b.expired }
    }
    File.write(ENV.fetch("TESTFLIGHT_JSON"), JSON.generate(state))
    UI.message("TestFlight: #{state}")
  end

  desc "List every profile of the signed App IDs with its type and state"
  lane :profiles do
    asc_api_key
    report_profiles
  end

  # After a capability change on an App ID: new profiles (the app's and the
  # widget's, from the Matchfile) signed by the existing distribution
  # certificate, pushed to the match repo. MATCH_TYPES is appstore, or
  # appstore,adhoc. match creates a certificate only when the repo holds none
  # of the type: the repo has the distribution one only, so development is
  # refused, and the certificate must still be on the portal. This never
  # creates or revokes a certificate.
  desc "Regenerate the App Store (and ad hoc) profiles in the match repo with the existing certificate"
  lane :renew_profile do
    api_key = asc_api_key
    certificate_id = ENV.fetch("MATCH_CERTIFICATE_ID", "GN85KDC962")
    types = ENV.fetch("MATCH_TYPES", "appstore").split(",").map(&:strip)
    unknown = types - %w[appstore adhoc]
    unless unknown.empty?
      UI.user_error!("MATCH_TYPES #{unknown.join(', ')}: the match repo has no development certificate, " \
                     "so match would create one. Development profiles are Xcode's (automatic signing).")
    end
    certificate = Spaceship::ConnectAPI::Certificate.all.find { |c| c.id == certificate_id }
    if certificate.nil? || Time.parse(certificate.expiration_date) < Time.now
      UI.user_error!("Certificate #{certificate_id} is #{certificate ? 'expired' : 'not on the portal'}: " \
                     "match would create a new one. Stop and ask the account holder.")
    end
    report_profiles
    types.each do |type|
      match(
        type: type,
        readonly: false,
        force: ENV.fetch("MATCH_FORCE", "true") == "true",
        certificate_id: certificate_id,
        renew_expired_certs: false,
        api_key: api_key,
        team_id: ENV.fetch("APPLE_TEAM_ID")
      )
    end
    report_profiles
  end

  def report_profiles
    profiles = Spaceship::ConnectAPI::Profile.all(includes: "bundleId")
                                             .select { |p| SIGNED_TARGETS.key?(p.bundle_id&.identifier) }
    UI.message("No profiles for #{SIGNED_TARGETS.keys.join(', ')}") if profiles.empty?
    profiles.sort_by { |p| [p.bundle_id.identifier, p.profile_type, p.name] }.each do |p|
      UI.message("#{p.bundle_id.identifier}  #{p.profile_type}  #{p.profile_state}  '#{p.name}'  expires #{p.expiration_date}")
    end
  end

  desc "Build the release IPA; upload it to TestFlight (RELEASE_UPLOAD=true) or validate it"
  lane :beta do
    api_key = asc_api_key
    team_id = ENV.fetch("APPLE_TEAM_ID")
    setup_ci if ENV["CI"]
    match(readonly: true, api_key: api_key, team_id: team_id)
    profiles = SIGNED_TARGETS.keys.to_h { |id| [id, ENV.fetch("sigh_#{id}_appstore_profile-name")] }

    # The project keeps automatic signing for local development; the release
    # build signs manually with what match installed.
    SIGNED_TARGETS.each do |id, target|
      update_code_signing_settings(
        path: File.join(APP_DIR, "ios/Runner.xcodeproj"),
        use_automatic_signing: false,
        team_id: team_id,
        code_sign_identity: "Apple Distribution",
        bundle_identifier: id,
        profile_name: profiles.fetch(id),
        targets: [target]
      )
    end

    export_options = File.join(APP_DIR, "build/ios/ExportOptions.plist")
    FileUtils.mkdir_p(File.dirname(export_options))
    File.write(export_options, {
      "method" => "app-store-connect",
      "destination" => "export",
      "signingStyle" => "manual",
      "teamID" => team_id,
      "signingCertificate" => "Apple Distribution",
      "provisioningProfiles" => profiles,
      "uploadSymbols" => true,
      "manageAppVersionAndBuildNumber" => false
    }.to_plist)

    flutter("build", "ipa", "--release", "--build-number=#{build_number}",
            "--dart-define-from-file=config/auth.json", *analytics_defines,
            "--export-options-plist=#{export_options}")

    ipa = Dir.glob(File.join(APP_DIR, "build/ios/ipa/*.ipa")).first
    UI.user_error!("no IPA under build/ios/ipa") if ipa.nil?
    # ITMS-90626: the signed app must carry its SiriKit example phrases (scripts/siri-vocabulary.py).
    sh("python3", File.join(APP_DIR, "../scripts/siri-vocabulary.py"), ipa)
    # The App Shortcuts Siri matches, with their de and en phrases (job 97).
    sh("python3", File.join(APP_DIR, "../scripts/app-shortcuts-bundle.py"), ipa)
    # TestFlight devices get push only from a build signed with aps-environment production (job 468).
    sh("python3", File.join(APP_DIR, "../scripts/ios-push-entitlements.py"), ipa)
    upload? ? upload_ipa(api_key, ipa) : validate_ipa(ipa)
  end

  # Internal testers only: no external distribution, no Beta App Review. The
  # group "Familie" has access to all builds, so a VALID build reaches it
  # without a distribute step. Export compliance is answered by Info.plist.
  def upload_ipa(api_key, ipa)
    attempts = 0
    begin
      attempts += 1
      upload_to_testflight(
        api_key: api_key,
        ipa: ipa,
        app_identifier: APP_ID,
        distribute_external: false,
        skip_submission: true,
        # fastlane then logs "no changelog supplied": wait_processing sets
        # What to Test once the build shows up in App Store Connect.
        skip_waiting_for_build_processing: true
      )
    rescue StandardError => e
      raise if attempts > 1
      # An Apple outage gets one more try. If the first attempt reached ASC
      # after all, a second upload of the same number would be rejected, so
      # look for the build for 10 minutes first.
      UI.important("Upload failed (#{e.message}); checking App Store Connect before one more try")
      20.times do
        sleep(30)
        if Spaceship::ConnectAPI::Build.all(app_id: asc_app.id, build_number: build_number, limit: 1).any?
          UI.message("Build #{build_number} reached App Store Connect after all")
          return
        end
      end
      retry
    end
  end

  # altool looks for the key in ~/.appstoreconnect/private_keys.
  def validate_ipa(ipa)
    key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ID")
    dir = File.expand_path("~/.appstoreconnect/private_keys")
    key_file = File.join(dir, "AuthKey_#{key_id}.p8")
    FileUtils.mkdir_p(dir)
    File.write(key_file, ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"), perm: 0o600)
    begin
      sh("xcrun", "altool", "--validate-app", "--file", ipa, "--type", "ios",
         "--apiKey", key_id, "--apiIssuer", ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"))
    ensure
      File.delete(key_file)
    end
    UI.success("App Store Connect validated #{File.basename(ipa)} (#{build_number}); nothing was uploaded")
  end

  # Sets What to Test (RELEASE_NOTES_DE/_EN) as soon as the build shows up,
  # then waits until Apple has processed it. A build that ends INVALID or
  # FAILED, is still processing after WAIT_MINUTES, or comes out already
  # expired fails the run, which opens the "Internal release failed" issue.
  desc "Set What to Test on BUILD_NUMBER and wait until TestFlight processed it"
  lane :wait_processing do
    asc_api_key
    app = asc_app
    deadline = Time.now + (ENV.fetch("WAIT_MINUTES", "45").to_i * 60)
    notes = { "de-DE" => ENV.fetch("RELEASE_NOTES_DE"), "en-US" => ENV.fetch("RELEASE_NOTES_EN") }
    notes_set = false
    errors = 0
    loop do
      begin
        build = Spaceship::ConnectAPI::Build.all(app_id: app.id, build_number: build_number, limit: 1).first
        errors = 0
      rescue StandardError => e
        # One failed request is retried; two in a row are an outage.
        errors += 1
        UI.user_error!("App Store Connect API failed twice in a row: #{e.message}") if errors > 1
        UI.important("App Store Connect API failed (#{e.message}); retrying")
        sleep(60)
        next
      end

      if build && !notes_set
        set_whats_new(build, notes)
        notes_set = true
      end
      state = build&.processing_state
      UI.message("Build #{build_number}: #{state || 'not in App Store Connect yet'}")
      case state
      when "VALID"
        if build.expired
          UI.user_error!("Build #{build_number} is VALID but already expired (docs/RELEASE.md, TestFlight builds expired)")
        end
        UI.success("Build #{build_number} is VALID and available to the internal group")
        break
      when "INVALID", "FAILED"
        UI.user_error!("Build #{build_number} processing ended #{state}; Apple's email to the account holder names the reason")
      end
      UI.user_error!("Build #{build_number} is still #{state || 'missing'} after the wait") if Time.now > deadline
      sleep(30)
    end
  end

  # Notes are a courtesy: a refusal warns instead of failing a build that
  # reached the testers. pilot's sanitizer drops what Apple rejects (emoji,
  # "<") and cuts to 4000 bytes.
  def set_whats_new(build, notes)
    require "pilot"
    existing = Spaceship::ConnectAPI.get_beta_build_localizations(filter: { build: build.id }).to_models
    notes.each do |locale, text|
      attributes = { whatsNew: Pilot::BuildManager.sanitize_changelog(text) }
      localization = existing.find { |l| l.locale == locale }
      if localization
        Spaceship::ConnectAPI.patch_beta_build_localizations(localization_id: localization.id, attributes: attributes)
      else
        Spaceship::ConnectAPI.post_beta_build_localizations(build_id: build.id, attributes: attributes.merge(locale: locale))
      end
    end
    UI.success("What to Test set for #{notes.keys.join(', ')}")
  rescue StandardError => e
    UI.important("Could not set What to Test: #{e.message}")
  end
end

platform :android do
  desc "Build the release App Bundle (signed with android/key.properties)"
  lane :build do
    flutter("build", "appbundle", "--release", "--build-number=#{build_number}",
            "--dart-define-from-file=config/auth.json", *analytics_defines)
  end

  # Credentials come from Workload Identity Federation: google-github-actions/auth
  # writes an external_account file and points GOOGLE_APPLICATION_CREDENTIALS at it.
  def play_json_key
    ENV.fetch("GOOGLE_APPLICATION_CREDENTIALS") { UI.user_error!("no Google credentials (GOOGLE_APPLICATION_CREDENTIALS)") }
  end

  # Writes "ok" or the Play API's refusal to PLAY_ACCESS_FILE. A failed token
  # exchange (Workload Identity Federation, IAM) fails the lane instead: that is
  # this repo's setup, not the Play app's.
  desc "Check that the service account can open an edit on the Play app"
  lane :play_access do
    require "supply"
    config = FastlaneCore::Configuration.create(Supply::Options.available_options,
                                                { json_key: play_json_key, package_name: APP_ID })
    client = Supply::Client.make_from_config(params: config)
    UI.success("Got a Google access token for the service account")
    result = begin
      client.begin_edit(package_name: APP_ID)
      client.abort_current_edit
      "ok"
    rescue FastlaneCore::Interface::FastlaneError => e
      e.message.lines.first.strip
    end
    UI.message("Play access for #{APP_ID}: #{result}")
    File.write(ENV.fetch("PLAY_ACCESS_FILE"), result)
  end

  desc "Upload the AAB to the Play internal track (RELEASE_UPLOAD=true) or validate it"
  lane :internal do
    upload_to_play_store(
      package_name: APP_ID,
      json_key: play_json_key,
      track: "internal",
      # Play accepts only draft releases until the app has been published once.
      release_status: ENV.fetch("PLAY_RELEASE_STATUS"),
      aab: AAB,
      validate_only: !upload?,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  def play_client(**options)
    require "supply"
    Supply.config = FastlaneCore::Configuration.create(Supply::Options.available_options,
                                                       { json_key: play_json_key, package_name: APP_ID, **options })
    client = Supply::Client.make_from_config(params: Supply.config)
    client.begin_edit(package_name: APP_ID)
    client
  end

  def describe_releases(track)
    (track&.releases || []).map { |r| "#{r.status} #{r.version_codes&.join(',')} (#{r.name})" }.join("; ")
  end

  # Play sends a release's versionCodes as strings (int64).
  def carries?(release, version_code)
    (release.version_codes || []).map(&:to_s).include?(version_code.to_s)
  end

  # Only closed testing: production and the open track stay with Play Console.
  PROMOTE_TRACKS = %w[alpha].freeze

  # Sets a bundle already in Play's library (VERSION_CODE) as the draft release of PROMOTE_TRACK.
  # The track's other releases stay as they are, so its testers keep their build until someone
  # rolls the draft out in Play Console; an older draft there is replaced. The release notes are
  # those of a release that already carries the version code (internal first), else none. The
  # commit asks Play not to send changes for review; when Play answers that this app's changes are
  # sent for review automatically, supply's rescue commits without that flag. The edit holds only
  # a draft, which this commit neither sends for review nor rolls out. Afterwards a second edit
  # reads the track back and is deleted.
  desc "Set an uploaded versionCode as the draft release of a closed testing track"
  lane :promote_draft do
    version_code = Integer(ENV.fetch("VERSION_CODE"), 10)
    track_name = ENV.fetch("PROMOTE_TRACK")
    UI.user_error!("PROMOTE_TRACK must be one of #{PROMOTE_TRACKS.join(', ')}, not #{track_name}") unless PROMOTE_TRACKS.include?(track_name)

    client = play_client(changes_not_sent_for_review: true)
    # The edit's bundle list stopped naming 1414 after newer builds arrived (job 316), so it only
    # informs. Play refuses a versionCode it lacks when the track is set or at validate or commit;
    # the commit is atomic, so nothing lands.
    listed = client.aab_version_codes
    UI.message("The edit lists #{listed.size} bundles (#{listed.sort.join(',')}), " \
               "#{listed.include?(version_code) ? '' : 'not '}#{version_code}")
    tracks = client.tracks
    tracks.each { |t| UI.message("Before: #{t.track}: #{describe_releases(t)}") }
    source = (tracks.sort_by { |t| t.track == "internal" ? 0 : 1 })
             .flat_map { |t| t.releases || [] }
             .find { |r| carries?(r, version_code) }
    UI.message(source ? "Release notes from the release #{source.name}" : "No release carries #{version_code}: no release notes")
    # The versionCode in the name tells the draft apart from a live release of the same version.
    # A field set to nil is sent and breaks the client's serializer; leave it unset instead.
    copied = { release_notes: source&.release_notes }.compact
    draft = AndroidPublisher::TrackRelease.new(name: source ? "#{source.name} (#{version_code})" : version_code.to_s,
                                               status: Supply::ReleaseStatus::DRAFT, version_codes: [version_code], **copied)
    track = tracks.find { |t| t.track == track_name } || AndroidPublisher::Track.new(track: track_name, releases: [])
    track.releases = (track.releases || []).reject { |r| r.status == Supply::ReleaseStatus::DRAFT } + [draft]
    begin
      client.update_track(track_name, track)
      if ENV.fetch("PROMOTE_COMMIT", "false") == "true"
        client.commit_current_edit!
        UI.success("Committed: #{track_name} has versionCode #{version_code} as its draft release")
      else
        client.validate_current_edit!
        client.abort_current_edit
        UI.success("Validated only (PROMOTE_COMMIT is not true); nothing changed on Play")
      end
    rescue StandardError
      begin
        client.abort_current_edit
      rescue StandardError => e
        UI.important("Could not delete the edit (Play expires it): #{e.message}")
      end
      raise
    end

    check = play_client
    after = check.tracks(track_name).first
    check.abort_current_edit
    UI.message("After: #{track_name}: #{describe_releases(after)}")
    next unless ENV.fetch("PROMOTE_COMMIT", "false") == "true"

    drafts = (after&.releases || []).select { |r| r.status == Supply::ReleaseStatus::DRAFT }
    UI.user_error!("#{track_name} has no draft with versionCode #{version_code}") unless drafts.any? { |r| carries?(r, version_code) }
  end

  # Production's releases with their lifecycle state, read without opening an edit.
  def production_releases
    require "supply"
    Supply.config = FastlaneCore::Configuration.create(Supply::Options.available_options,
                                                       { json_key: play_json_key, package_name: APP_ID })
    PlayListing.production_releases(Supply::Client.make_from_config(params: Supply.config).client, APP_ID)
  end

  # supply's client without its changesNotSentForReview rescue: PlayListing.commit retries that
  # commit itself and fails the run, since such a change waits for Ops to send it for review.
  def listing_client
    play_client(rescue_changes_not_sent_for_review: false).extend(PlayListing::SupplyCommit)
  end

  # PLAY_LISTING_HELD_FROM (ISO 8601): when the held-release path opens. The Play listing workflow
  # passes Peter K1's launch-day start unless the dispatch names a later one (an earlier one refuses,
  # PlayListing::HELD_FROM_FLOOR).
  def listing_held_from
    raw = ENV.fetch("PLAY_LISTING_HELD_FROM", "")
    raw.empty? ? nil : Time.iso8601(raw)
  end

  # The staged listing text (title, short and full description of every locale under
  # metadata/android) in one edit, nothing else: no bundle, track, changelog, image or screenshot.
  # RELEASE_UPLOAD=true commits only when production's release PLAY_PUBLISHED_VERSION_CODE is
  # PUBLISHED, or, with PLAY_LISTING_WITH_HELD_RELEASE=true, still held by managed publishing and
  # it is PLAY_LISTING_HELD_FROM or later (PlayListing.blockers; Peter K1, Legal LK1); then it
  # reads every field back and fails on any difference. Otherwise it validates and deletes the
  # edit. docs/RELEASE.md "Store listing upload".
  desc "Upload the staged Play listing text with or after the production release (RELEASE_UPLOAD=true) or validate it"
  lane :listing do
    texts = PlayListing.load(PLAY_METADATA)
    PlayListing.run(texts: texts, upload: upload?, version_code: ENV.fetch("PLAY_PUBLISHED_VERSION_CODE", ""),
                    production_releases: production_releases, new_client: -> { listing_client },
                    with_held_release: ENV.fetch("PLAY_LISTING_WITH_HELD_RELEASE", "false") == "true",
                    held_from: listing_held_from, log: ->(line) { UI.message(line) })
    UI.success(upload? ? "Play's listing equals the repo text in #{texts.keys.join(', ')}" : "Validated only")
  rescue PlayListing::Refused => e
    UI.user_error!(e.message)
  end

  # Read only and without an edit: production's releases, and whether each upload path would
  # commit for PLAY_PUBLISHED_VERSION_CODE now. Fails unless the build is held or published.
  desc "Show production's releases and which listing upload path would pass, without opening an edit"
  lane :listing_preflight do
    PlayListing.preflight(production_releases: production_releases,
                          version_code: ENV.fetch("PLAY_PUBLISHED_VERSION_CODE", ""), held_from: listing_held_from,
                          now: Time.now, log: ->(line) { UI.message(line) })
    UI.success("An upload path can use production #{ENV.fetch('PLAY_PUBLISHED_VERSION_CODE', '')}")
  rescue PlayListing::Refused => e
    UI.user_error!(e.message)
  end

  # Read only. Play's listing (a fresh edit, deleted) must equal the repo text field by field, and
  # each locale's public store page must show the repo's full description, without Legal LK1's
  # sentence. Fails until the listing is uploaded and published.
  desc "Compare Play's listing and public store page with the staged repo text"
  lane :listing_check do
    texts = PlayListing.load(PLAY_METADATA)
    log = ->(line) { UI.message(line) }
    mismatches = PlayListing.read_back(client: play_client, texts: texts, log: log)
    texts.each do |locale, fields|
      status, html = PlayListing.fetch_store_page(APP_ID, locale)
      mismatches += PlayListing.public_mismatches(locale: locale, status: status, html: html,
                                                  text: fields["full_description"], log: log)
    end
    UI.user_error!("Listing not live as staged: #{mismatches.join('; ')}") unless mismatches.empty?
    UI.success("Play's listing and store pages equal the repo text in #{texts.keys.join(', ')}")
  rescue PlayListing::Refused => e
    UI.user_error!(e.message)
  end
end
