	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>SNACKLIST_NAME_1</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>SNACKLIST_HINT_1</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>SNACKLIST_NAME_2</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>SNACKLIST_HINT_2</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>SNACKLIST_NAME_3</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>SNACKLIST_HINT_3</string>
		</dict>
	</array>
	<key>INIntentsSupported</key>
	<array>
		<string>INAddTasksIntent</string>
		<string>INSearchForNotebookItemsIntent</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Snacklist braucht das Mikrofon, damit du Einträge diktieren kannst.</string>
	<key>NSMotionUsageDescription</key>
	<string>Schüttle das Handy, um ein Problem mit dem Bildschirm zu melden, auf dem du gerade bist.</string>
	<key>NSSiriUsageDescription</key>
	<string>Mit Siri setzt du Einträge auf deine Snacklist und lässt sie dir vorlesen.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Snacklist wandelt deine Sprache in Text um, damit du Einträge diktieren kannst.</string>
